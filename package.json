{
  "name": "localkit",
  "private": true,
  "version": "0.2.0",
  "description": "Local-first document & image toolkit — watermark KTP, batch image compressor, and PDF tools. No uploads, fully client-side.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "predev": "node scripts/copy-ghostscript.mjs",
    "build": "tsc -b && vite build",
